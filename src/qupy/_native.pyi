from enum import Enum
from typing import overload

import numpy as np
import numpy.typing as npt

class OperationCode(Enum):
    H = ...
    X = ...
    Y = ...
    Z = ...
    RX = ...
    RY = ...
    RZ = ...
    CX = ...
    CZ = ...
    SWAP = ...


class ResultMode(Enum):
    SAMPLE = ...
    EXPECTATION = ...
    PROBABILITIES = ...
    VARIANCE = ...
    STATEVECTOR = ...


class Pauli(Enum):
    I = ...
    X = ...
    Y = ...
    Z = ...


class GradientMethod(Enum):
    AUTO = ...
    ADJOINT = ...
    PARAMETER_SHIFT = ...
    FINITE_DIFFERENCE = ...


class ProviderJobState(Enum):
    QUEUED = ...
    RUNNING = ...
    SUCCEEDED = ...
    FAILED = ...
    CANCELLED = ...


class NoiseChannelCode(Enum):
    BIT_FLIP = ...
    PHASE_FLIP = ...
    DEPOLARIZING = ...
    AMPLITUDE_DAMPING = ...
    PHASE_DAMPING = ...
    PAULI = ...
    KRAUS = ...


class Operation:
    @property
    def name(self) -> str: ...
    @property
    def code(self) -> OperationCode: ...
    @property
    def qubits(self) -> list[int]: ...
    @property
    def parameters(self) -> list[float]: ...


class ParameterSlot:
    def __init__(self, operation_index: int, parameter_index: int = 0) -> None: ...
    @property
    def operation_index(self) -> int: ...
    @property
    def parameter_index(self) -> int: ...


class Program:
    def __init__(self, num_qubits: int) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def operations(self) -> list[Operation]: ...
    @property
    def canonical_text(self) -> str: ...
    @property
    def fingerprint(self) -> str: ...
    def bind(self, slots: list[ParameterSlot], values: list[float]) -> Program: ...


class PauliZ:
    @property
    def qubit(self) -> int: ...


class PauliFactor:
    def __init__(self, qubit: int, pauli: Pauli) -> None: ...
    @property
    def qubit(self) -> int: ...
    @property
    def pauli(self) -> Pauli: ...


class PauliTerm:
    def __init__(self, coefficient: float, factors: list[PauliFactor]) -> None: ...
    @property
    def coefficient(self) -> float: ...
    @property
    def factors(self) -> list[PauliFactor]: ...
    @property
    def canonical_text(self) -> str: ...


class Observable:
    def __init__(self, terms: list[PauliTerm]) -> None: ...
    @property
    def terms(self) -> list[PauliTerm]: ...
    @property
    def canonical_text(self) -> str: ...
    @property
    def fingerprint(self) -> str: ...


class Target:
    @property
    def name(self) -> str: ...
    @property
    def operations(self) -> list[OperationCode]: ...
    @property
    def result_modes(self) -> list[ResultMode]: ...
    @property
    def max_qubits(self) -> int | None: ...
    @property
    def simulator(self) -> bool: ...
    @property
    def state_access(self) -> bool: ...
    @property
    def mid_circuit_measurement(self) -> bool: ...
    @property
    def reset(self) -> bool: ...
    @property
    def dynamic_control(self) -> bool: ...
    @property
    def parameter_batches(self) -> bool: ...
    @property
    def fingerprint(self) -> str: ...
    def supports_operation(self, code: OperationCode) -> bool: ...
    def supports_result(self, mode: ResultMode) -> bool: ...


